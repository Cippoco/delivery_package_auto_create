<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_delivery_auto_create_packages_wizard_form" model="ir.ui.view">
        <field name="name">delivery.auto.create.packages.wizard.form</field>
        <field name="model">delivery.auto.create.packages.wizard</field>
        <field name="arch" type="xml">
            <form string="Genera colli">
                <group>
                    <group>
                        <field name="move_id" invisible="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="picking_id" readonly="1"/>
                        <field name="location_id" readonly="1"/>
                        <field name="location_dest_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="qty_per_package"/>
                        <field name="result_package_id"
                               context="{'picking_id': picking_id}"
                               domain="['|', ('location_id','=',False), ('location_id','=',location_dest_id)]"
                               options="{'no_create': True}"/>
                    </group>
                </group>

                <footer>
                    <button string="Genera colli"
                            name="action_generate_packages"
                            type="object"
                            class="btn-primary"/>
                    <button string="Annulla" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action (XMLID richiesto dal tuo stock_move.py) -->
    <record id="action_delivery_auto_create_packages_wizard" model="ir.actions.act_window">
        <field name="name">Genera colli</field>
        <field name="res_model">delivery.auto.create.packages.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_delivery_auto_create_packages_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_move_id': active_id}</field>
    </record>

</odoo>
