<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_auto_create_packages_wizard_form" model="ir.ui.view">
        <field name="name">delivery.auto.create.packages.wizard.form</field>
        <field name="model">delivery.auto.create.packages.wizard</field>
        <field name="arch" type="xml">
            <form string="Genera colli">
                <sheet>
                    <!-- campo tecnico, non mostrato -->
                    <field name="move_id" invisible="1"/>
                    <field name="product_id" invisible="1"/>

                    <group>
                        <field name="qty_per_package"/>
                        <field name="location_id"/>
                        <field name="quant_id"
                               domain="[('product_id', '=', product_id), ('location_id', 'child_of', location_id), ('quantity', '&gt;', 0)]"
                               context="{'default_location_id': location_id, 'default_product_id': product_id,
                                         'search_view_ref': 'stock.quant_search_view',
                                         'list_view_ref': 'stock.view_stock_quant_tree',
                                         'form_view_ref': 'stock.view_stock_quant_form',
                                         'readonly_form': True}"
                               widget="pick_from"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="location_dest_id"/>
                        <field name="result_package_id"
                               context="{'picking_id': move_id.picking_id}"
                               options="{'no_create': True}"/>
                    </group>
                </sheet>

                <footer>
                    <button name="action_generate_packages" type="object" class="btn-primary" string="Genera colli"/>
                    <button string="Annulla" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_delivery_auto_create_packages_wizard" model="ir.actions.act_window">
        <field name="name">Genera colli</field>
        <field name="res_model">delivery.auto.create.packages.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_delivery_auto_create_packages_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_move_id': active_id}</field>
    </record>
