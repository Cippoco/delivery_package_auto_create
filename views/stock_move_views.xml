<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_move_operations_inherit_generate_packages" model="ir.ui.view">
        <field name="name">stock.move.operations.form.inherit.generate.packages</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">

            <!-- Se il form NON ha footer, lo aggiungiamo dentro form -->
            <xpath expr="//form" position="inside">
                <footer>
                    <!-- Mantengo i bottoni standard -->
                    <button string="Salva" special="save" class="btn-primary"/>
                    <button string="Abbandona" special="cancel" class="btn-secondary"/>

                    <!-- Il tuo bottone vicino a Salva -->
                    <button name="action_open_delivery_auto_create_packages_wizard"
                            type="object"
                            string="Genera colli"
                            class="btn-primary"/>
                </footer>
            </xpath>

        </field>
    </record>

</odoo>
