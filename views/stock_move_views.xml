<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_add_generate_colli_btn" model="ir.ui.view">
        <field name="name">stock.picking.form.generate.colli.btn</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <!--        <field name="priority">100</field>-->
        <field name="arch" type="xml">

            <!-- Inserisco il bottone come colonna nella list dei move (move_ids_without_package) -->
            <!--            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']" position="after">-->
            <xpath expr="//list" position="inside">
                <button type="object"
                        name="action_open_delivery_auto_create_packages_wizard"
                        string="Genera Colli"
                        icon="fa-cubes"
                        class="btn-link"/>
            </xpath>

        </field>
    </record>

    <record id="view_stock_move_operations_inherit_my" model="ir.ui.view">
        <field name="name">stock.move.operations.form.inherit.my</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <!-- esempio: aggiungo un bottone -->
            <xpath expr="//field[@name='move_line_ids']" position="before">
<!--                <button name="my_action" type="object" string="Mia azione" class="btn-primary"/>-->
            </xpath>
        </field>
    </record>

</odoo>
