<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_move_operations_inherit_delivery_package_auto_create" model="ir.ui.view">
        <field name="name">stock.move.operations.form.inherit.delivery_package_auto_create</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">

            <!-- Se la form non ha footer, lo aggiungiamo noi -->
            <xpath expr="//form" position="inside">
                <footer>
                    <button name="action_open_delivery_auto_create_packages_wizard"
                            type="object"
                            string="Genera colli"
                            class="btn-primary"/>
                    <button string="Chiudi" special="cancel" class="btn-secondary"/>
                </footer>
            </xpath>

        </field>
    </record>

</odoo>
