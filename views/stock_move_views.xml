<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit della form popup "Move Detail" -->
    <record id="view_stock_move_operations_inherit_delivery_auto_create_packages" model="ir.ui.view">
        <field name="name">stock.move.operations.form.inherit.delivery.auto.create.packages</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="priority">1100</field>
        <field name="arch" type="xml">

            <!-- Metto il bottone DOPO la tabella righe (quindi in basso) -->
            <xpath expr="//field[@name='move_line_ids']" position="after">
                <div class="d-flex justify-content-end mt-2">
                    <button
                        type="object"
                        name="action_open_delivery_auto_create_packages_wizard"
                        string="Genera colli"
                        class="btn btn-primary"
                        icon="fa-cubes"
                    />
                </div>
            </xpath>

        </field>
    </record>

</odoo>